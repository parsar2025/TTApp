<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_background">
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="TTApp" android:textSize="16sp"
        android:textColor="#E7F0F2" android:maxLines="1" android:ellipsize="end"/>
    <TextView android:id="@+id/widget_start" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Ready" android:textSize="12sp"
        android:textColor="#00D9E8" android:layout_marginTop="3dp"/>
    <LinearLayout android:id="@+id/widget_controls" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="horizontal"
        android:layout_marginTop="8dp">
        <Button android:id="@+id/widget_toggle" android:layout_width="0dp"
            android:layout_height="40dp" android:layout_weight="1" android:text="Pause"
            android:textSize="11sp" android:padding="0dp"/>
        <Button android:id="@+id/widget_check" android:layout_width="0dp"
            android:layout_height="40dp" android:layout_weight="1" android:text="Check"
            android:textSize="11sp" android:padding="0dp"/>
        <Button android:id="@+id/widget_stop" android:layout_width="0dp"
            android:layout_height="40dp" android:layout_weight="1" android:text="Stop"
            android:textSize="11sp" android:padding="0dp"/>
    </LinearLayout>
</LinearLayout>
